# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a real Gemini API key from https://aistudio.google.com/apikey
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VAPID keys for web push notifications
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"

# Supabase integration
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# The name of the Supabase Storage bucket. Must exactly match an existing bucket in your Supabase dashboard's Storage settings. Defaults to "basket" if unset. Ensure this bucket is set to public read access.
VITE_SUPABASE_STORAGE_BUCKET="basket"

# Secret key from Supabase dashboard > Settings > API > service_role. Required server-side only so the background reminder job can read all users' data, bypassing RLS. NEVER expose this to the frontend or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
